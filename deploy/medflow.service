[Unit]
Description=Medical referral demo
After=network.target

[Service]
Type=simple
User=medflow
Group=medflow
WorkingDirectory=/opt/medflow
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/medflow/.venv/bin/python -m uvicorn medflow.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
